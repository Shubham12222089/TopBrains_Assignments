FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY ["OrderManagementSystem/OrderManagementSystem.csproj", "OrderManagementSystem/"]
RUN dotnet restore "OrderManagementSystem/OrderManagementSystem.csproj"

COPY . .
WORKDIR "/src/OrderManagementSystem"
RUN dotnet build "OrderManagementSystem.csproj" -c Release -o /app/build

FROM build AS publish
RUN dotnet publish "OrderManagementSystem.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
EXPOSE 5203

COPY --from=publish /app/publish .
COPY OrderManagementSystem/docker-entrypoint.sh /app/docker-entrypoint.sh

RUN chmod +x /app/docker-entrypoint.sh

ENTRYPOINT ["/app/docker-entrypoint.sh"]
