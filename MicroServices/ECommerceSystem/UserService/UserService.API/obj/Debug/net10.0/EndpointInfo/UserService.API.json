            "minLength": 0,
            "type": "string"
          },
          "Country": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "IsDefaultShipping": {
            "type": "boolean"
          },
          "IsDefaultBilling": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "AddressDTOApiResponse": {
        "type": "object",
        "properties": {
          "Success": {
            "type": "boolean"
          },
          "Data": {
            "$ref": "#/components/schemas/AddressDTO"
          },
          "Message": {
            "type": "string",
            "nullable": true
          },
          "Errors": {
            "type": "array",
            "items": {
              "type": "string"
