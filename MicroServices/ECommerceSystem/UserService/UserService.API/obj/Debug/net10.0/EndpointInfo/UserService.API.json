  "components": {
    "schemas": {
      "AddressDTO": {
        "required": [
          "AddressLine1",
          "City",
          "Country",
          "PostalCode",
          "State",
          "userId"
        ],
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "AddressLine1": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "AddressLine2": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "City": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "State": {
