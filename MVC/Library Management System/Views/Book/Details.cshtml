@model LibraryManagementSystem.Models.Book

@{
    ViewData["Title"] = "Book Details";
}

<h1>Book Details</h1>

<div class="card" style="max-width: 500px;">
    <div class="card-header bg-primary text-white">
        <h4>@Model.Title</h4>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">Book ID</dt>
            <dd class="col-sm-8">@Model.BookId</dd>

            <dt class="col-sm-4">Title</dt>
            <dd class="col-sm-8">@Model.Title</dd>

            <dt class="col-sm-4">Author</dt>
            <dd class="col-sm-8">@Model.Author</dd>

            <dt class="col-sm-4">Price</dt>
            <dd class="col-sm-8">₹@Model.Price.ToString("N2")</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="List" class="btn btn-secondary">Back to List</a>
    <a asp-action="Delete" asp-route-id="@Model.BookId" class="btn btn-danger">Delete</a>
</div>
