@model LibraryManagementSystem.Models.Book

@{
    ViewData["Title"] = "Delete Book";
}

<h1>Delete Book</h1>

<div class="alert alert-warning">
    <h4>Are you sure you want to delete this book?</h4>
</div>

<div class="card" style="max-width: 500px;">
    <div class="card-header bg-danger text-white">
        <h4>@Model.Title</h4>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">Book ID</dt>
            <dd class="col-sm-8">@Model.BookId</dd>

            <dt class="col-sm-4">Title</dt>
            <dd class="col-sm-8">@Model.Title</dd>

            <dt class="col-sm-4">Author</dt>
            <dd class="col-sm-8">@Model.Author</dd>

            <dt class="col-sm-4">Price</dt>
            <dd class="col-sm-8">₹@Model.Price.ToString("N2")</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="BookId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="List" class="btn btn-secondary">Cancel</a>
</form>
