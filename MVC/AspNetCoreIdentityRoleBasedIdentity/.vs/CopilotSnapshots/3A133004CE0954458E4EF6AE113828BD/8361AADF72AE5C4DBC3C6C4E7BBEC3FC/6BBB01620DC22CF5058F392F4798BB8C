@using Microsoft.AspNetCore.Identity
@using AspNetCoreIdentityRoleBasedIdentity.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    var user = await UserManager.GetUserAsync(User);
    var roles = await UserManager.GetRolesAsync(user);
    var role = roles?.FirstOrDefault() ?? "User";
    var badgeClass = role == "Admin" ? "badge-danger" : "badge-info";

    <li class="nav-item">
        <span class="nav-link text-dark">
            Hello <strong>@UserManager.GetUserName(User)</strong>
            <span class="badge @badgeClass ms-2">@role</span>
        </span>
    </li>
    <li class="nav-item">
        <form id="logoutForm" class="form-inline" asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
            <button id="logout" type="submit" class="nav-link btn btn-link text-dark border-0">Logout</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark" id="register" asp-controller="Account" asp-action="Register">Register</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark" id="login" asp-controller="Account" asp-action="Login">Login</a>
    </li>
}
</ul>
