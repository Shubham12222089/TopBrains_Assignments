@model StudentManagementSystem.Models.Course

@{
    ViewData["Title"] = "Delete Course";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white">
                    <h4><i class="bi bi-exclamation-triangle"></i> Delete Course</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-danger">
                        <strong>Warning!</strong> Are you sure you want to delete this course?
                    </div>

                    <dl class="row">
                        <dt class="col-sm-4">Course Name</dt>
                        <dd class="col-sm-8">@Model.CourseName</dd>

                        <dt class="col-sm-4">Duration</dt>
                        <dd class="col-sm-8">@Model.Duration</dd>

                        <dt class="col-sm-4">Department</dt>
                        <dd class="col-sm-8">@Model.Department?.DepartmentName</dd>

                        <dt class="col-sm-4">Enrolled Students</dt>
                        <dd class="col-sm-8">@(Model.Students?.Count ?? 0)</dd>
                    </dl>

                    <form asp-action="DeleteConfirmed" method="post" class="mt-4">
                        <input type="hidden" name="id" value="@Model.CourseId" />
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Confirm Delete
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Cancel
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
