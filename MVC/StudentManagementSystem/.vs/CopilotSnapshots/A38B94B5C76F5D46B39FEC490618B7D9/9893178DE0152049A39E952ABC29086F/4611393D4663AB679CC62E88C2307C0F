@model StudentManagementSystem.Models.Student

@{
    ViewData["Title"] = "Student Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h4><i class="bi bi-person-badge"></i> Student Details</h4>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">Student ID</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-secondary">@Model.StudentId</span>
                        </dd>

                        <dt class="col-sm-4">Name</dt>
                        <dd class="col-sm-8">@Model.Name</dd>

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">
                            <a href="mailto:@Model.Email">@Model.Email</a>
                        </dd>

                        <dt class="col-sm-4">Age</dt>
                        <dd class="col-sm-8">@Model.Age years</dd>

                        <dt class="col-sm-4">Gender</dt>
                        <dd class="col-sm-8">
                            @if (Model.Gender == "Male")
                            {
                                <span class="badge bg-info">@Model.Gender</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">@Model.Gender</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Admission Date</dt>
                        <dd class="col-sm-8">@Model.AdmissionDate.ToString("MMMM dd, yyyy")</dd>

                        <dt class="col-sm-4">Department</dt>
                        <dd class="col-sm-8">
                            @if (Model.Department != null)
                            {
                                <span class="badge bg-primary">@Model.Department.DepartmentName</span>
                                <br />
                                <small class="text-muted">Location: @Model.Department.Location</small>
                            }
                            else
                            {
                                <span class="text-muted">Not assigned</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Course</dt>
                        <dd class="col-sm-8">
                            @if (Model.Course != null)
                            {
                                <span class="badge bg-success">@Model.Course.CourseName</span>
                                <br />
                                <small class="text-muted">Duration: @Model.Course.Duration</small>
                            }
                            else
                            {
                                <span class="text-muted">Not enrolled</span>
                            }
                        </dd>
                    </dl>

                    <div class="mt-4">
                        <a asp-action="Edit" asp-route-id="@Model.StudentId" class="btn btn-warning">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.StudentId" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Delete
                        </a>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Back to List
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
