@model IEnumerable<StudentManagementSystem.Models.Student>

@{
    ViewData["Title"] = "Students";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-people"></i> Student List</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Create New Student
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (ViewBag.SearchTerm != null)
    {
        <div class="alert alert-info">
            <strong>Search Results for:</strong> @ViewBag.SearchTerm
            <a asp-action="Index" class="btn btn-sm btn-secondary float-end">Clear Search</a>
        </div>
    }

    @if (ViewBag.DepartmentName != null)
    {
        <div class="alert alert-info">
            <strong>Filtered by Department:</strong> @ViewBag.DepartmentName
            <a asp-action="Index" class="btn btn-sm btn-secondary float-end">Clear Filter</a>
        </div>
    }

    @if (ViewBag.CourseName != null)
    {
        <div class="alert alert-info">
            <strong>Filtered by Course:</strong> @ViewBag.CourseName
            <a asp-action="Index" class="btn btn-sm btn-secondary float-end">Clear Filter</a>
        </div>
    }

    @if (ViewBag.Title != null)
    {
        <div class="alert alert-info">
            <strong>@ViewBag.Title</strong>
            <a asp-action="Index" class="btn btn-sm btn-secondary float-end">View All</a>
        </div>
    }

    <div class="card shadow mb-4">
        <div class="card-header bg-light">
            <div class="row">
                <div class="col-md-6">
                    <form asp-action="Search" method="get" class="d-flex">
                        <input type="text" name="name" class="form-control me-2" placeholder="Search by name..." />
                        <button type="submit" class="btn btn-secondary">
                            <i class="bi bi-search"></i> Search
                        </button>
                    </form>
                </div>
                <div class="col-md-6 text-end">
                    <div class="dropdown d-inline">
                        <button class="btn btn-info dropdown-toggle" type="button" id="filterMenu" data-bs-toggle="dropdown">
                            <i class="bi bi-filter"></i> Quick Filters
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="filterMenu">
                            <li><a class="dropdown-item" asp-action="RecentAdmissions">Recent Admissions</a></li>
                            <li><a class="dropdown-item" asp-action="OlderThan" asp-route-age="25">Age &gt; 25</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" asp-action="Statistics">View Statistics</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-bordered table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Age</th>
                            <th>Gender</th>
                            <th>Admission Date</th>
                            <th>Department</th>
                            <th>Course</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Name</td>
                                <td>@item.Email</td>
                                <td>@item.Age</td>
                                <td>
                                    @if (item.Gender == "Male")
                                    {
                                        <span class="badge bg-info">@item.Gender</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">@item.Gender</span>
                                    }
                                </td>
                                <td>@item.AdmissionDate.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <span class="badge bg-primary">@item.Department?.DepartmentName</span>
                                </td>
                                <td>
                                    @if (item.Course != null)
                                    {
                                        <span class="badge bg-success">@item.Course.CourseName</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Not Enrolled</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@item.StudentId" 
                                           class="btn btn-sm btn-info" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.StudentId" 
                                           class="btn btn-sm btn-warning" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.StudentId" 
                                           class="btn btn-sm btn-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="alert alert-warning">
                    No students found.
                </div>
            }
        </div>
    </div>
</div>