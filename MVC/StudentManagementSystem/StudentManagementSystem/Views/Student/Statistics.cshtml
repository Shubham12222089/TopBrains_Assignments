@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Student Statistics";
}

<div class="container mt-4">
    <h2><i class="bi bi-graph-up"></i> Department-wise Student Statistics</h2>
    
    <div class="row mt-4">
        @foreach (var stat in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card text-white bg-primary shadow">
                    <div class="card-body">
                        <h5 class="card-title">@stat.DepartmentName</h5>
                        <p class="card-text display-4">@stat.TotalStudents</p>
                        <p class="card-text">Total Students</p>
                        <a asp-controller="Student" asp-action="ByDepartment" asp-route-id="@stat.DepartmentId" 
                           class="btn btn-light btn-sm">
                            View Students
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="mt-4">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to Students
        </a>
    </div>
</div>
