@model StudentManagementSystem.Models.Student

@{
    ViewData["Title"] = "Delete Student";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white">
                    <h4><i class="bi bi-exclamation-triangle"></i> Delete Student</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-danger">
                        <strong>Warning!</strong> Are you sure you want to delete this student? This action cannot be undone.
                    </div>

                    <dl class="row">
                        <dt class="col-sm-4">Student ID</dt>
                        <dd class="col-sm-8">@Model.StudentId</dd>

                        <dt class="col-sm-4">Name</dt>
                        <dd class="col-sm-8">@Model.Name</dd>

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8">@Model.Email</dd>

                        <dt class="col-sm-4">Age</dt>
                        <dd class="col-sm-8">@Model.Age years</dd>

                        <dt class="col-sm-4">Gender</dt>
                        <dd class="col-sm-8">@Model.Gender</dd>

                        <dt class="col-sm-4">Admission Date</dt>
                        <dd class="col-sm-8">@Model.AdmissionDate.ToString("MMMM dd, yyyy")</dd>

                        <dt class="col-sm-4">Department</dt>
                        <dd class="col-sm-8">
                            @if (Model.Department != null)
                            {
                                <span class="badge bg-primary">@Model.Department.DepartmentName</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Course</dt>
                        <dd class="col-sm-8">
                            @if (Model.Course != null)
                            {
                                <span class="badge bg-success">@Model.Course.CourseName</span>
                            }
                            else
                            {
                                <span class="text-muted">Not enrolled</span>
                            }
                        </dd>
                    </dl>

                    <form asp-action="DeleteConfirmed" asp-controller="Student" method="post" class="mt-4">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.StudentId" />
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Confirm Delete
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Cancel
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
