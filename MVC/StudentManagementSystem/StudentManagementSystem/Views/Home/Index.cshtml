@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">
    <div class="jumbotron bg-light p-5 rounded-3 shadow mb-4">
        <h1 class="display-4">
            <i class="bi bi-mortarboard-fill"></i> Student Management System
        </h1>
        <p class="lead">Corporate Training Institute - Enterprise Portal</p>
        <hr class="my-4">
        <p>Manage students, departments, and courses efficiently with our comprehensive management system.</p>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-white bg-primary shadow h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title">Total Students</h5>
                            <p class="display-4">@ViewBag.TotalStudents</p>
                        </div>
                        <div>
                            <i class="bi bi-people-fill" style="font-size: 3rem;"></i>
                        </div>
                    </div>
                    <a asp-controller="Student" asp-action="Index" class="btn btn-light btn-sm mt-2">
                        View All Students <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-white bg-success shadow h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title">Total Departments</h5>
                            <p class="display-4">@ViewBag.TotalDepartments</p>
                        </div>
                        <div>
                            <i class="bi bi-building" style="font-size: 3rem;"></i>
                        </div>
                    </div>
                    <a asp-controller="Department" asp-action="Index" class="btn btn-light btn-sm mt-2">
                        View All Departments <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-white bg-info shadow h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="card-title">Total Courses</h5>
                            <p class="display-4">@ViewBag.TotalCourses</p>
                        </div>
                        <div>
                            <i class="bi bi-book-fill" style="font-size: 3rem;"></i>
                        </div>
                    </div>
                    <a asp-controller="Course" asp-action="Index" class="btn btn-light btn-sm mt-2">
                        View All Courses <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card shadow">
                <div class="card-header bg-dark text-white">
                    <h5><i class="bi bi-clock-history"></i> Recent Admissions</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Department</th>
                                    <th>Course</th>
                                    <th>Admission Date</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var student in ViewBag.RecentStudents)
                                {
                                    <tr>
                                        <td>@student.Name</td>
                                        <td>@student.Email</td>
                                        <td>
                                            <span class="badge bg-primary">@student.Department?.DepartmentName</span>
                                        </td>
                                        <td>
                                            @if (student.Course != null)
                                            {
                                                <span class="badge bg-success">@student.Course.CourseName</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Not Enrolled</span>
                                            }
                                        </td>
                                        <td>@student.AdmissionDate.ToString("MMM dd, yyyy")</td>
                                        <td>
                                            <a asp-controller="Student" asp-action="Details" asp-route-id="@student.StudentId" 
                                               class="btn btn-sm btn-info">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card shadow">
                <div class="card-header bg-secondary text-white">
                    <h5><i class="bi bi-list-check"></i> Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            <a asp-controller="Student" asp-action="Create" class="btn btn-primary w-100 mb-2">
                                <i class="bi bi-person-plus"></i><br />Add Student
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a asp-controller="Department" asp-action="Create" class="btn btn-success w-100 mb-2">
                                <i class="bi bi-building-add"></i><br />Add Department
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a asp-controller="Course" asp-action="Create" class="btn btn-info w-100 mb-2">
                                <i class="bi bi-book-half"></i><br />Add Course
                            </a>
                        </div>
                        <div class="col-md-3">
                            <a asp-controller="Student" asp-action="Statistics" class="btn btn-warning w-100 mb-2">
                                <i class="bi bi-graph-up"></i><br />View Statistics
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
