@{
    ViewData["Title"] = "Teacher Dashboard";
}

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h2 class="mb-3">Teacher Dashboard</h2>
            <hr />
        </div>
    </div>

    <div class="row">
        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h5 class="card-title">Total Students</h5>
                    <p class="card-text display-4">@ViewBag.TotalStudents</p>
                </div>
                <div class="card-footer">
                    <a href="/Student" class="btn btn-sm btn-light">Manage</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h5 class="card-title">Total Courses</h5>
                    <p class="card-text display-4">@ViewBag.TotalCourses</p>
                </div>
                <div class="card-footer">
                    <a href="/Course" class="btn btn-sm btn-light">Manage</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <h5 class="card-title">Total Departments</h5>
                    <p class="card-text display-4">@ViewBag.TotalDepartments</p>
                </div>
                <div class="card-footer">
                    <a href="/Department" class="btn btn-sm btn-light">Manage</a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <h5 class="card-title">Quick Stats</h5>
                    <p class="card-text">All systems operational</p>
                </div>
                <div class="card-footer">
                    <a href="/StudentDashboard/Profile" class="btn btn-sm btn-light">View Profile</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Management Tools</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <h6 class="mb-3">Departments</h6>
                            <div class="list-group">
                                <a href="/Department" class="list-group-item list-group-item-action">View All Departments</a>
                                <a href="/Department/Create" class="list-group-item list-group-item-action">Add New Department</a>
                            </div>
                        </div>

                        <div class="col-md-4 mb-3">
                            <h6 class="mb-3">Courses</h6>
                            <div class="list-group">
                                <a href="/Course" class="list-group-item list-group-item-action">View All Courses</a>
                                <a href="/Course/Create" class="list-group-item list-group-item-action">Add New Course</a>
                            </div>
                        </div>

                        <div class="col-md-4 mb-3">
                            <h6 class="mb-3">Students</h6>
                            <div class="list-group">
                                <a href="/Student" class="list-group-item list-group-item-action">View All Students</a>
                                <a href="/Student/Create" class="list-group-item list-group-item-action">Add New Student</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>