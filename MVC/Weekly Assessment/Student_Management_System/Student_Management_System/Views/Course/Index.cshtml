@model IEnumerable<Course>

@{
    ViewData["Title"] = "Courses";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-8">
            <h2>Courses</h2>
        </div>
        <div class="col-md-4 text-end">
            <a class="btn btn-primary" asp-controller="Course" asp-action="Create">Add New Course</a>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Course Name</th>
                    <th>Duration</th>
                    <th>Fees</th>
                    <th>Department</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CourseName</td>
                        <td>@item.Duration</td>
                        <td>@item.Fees.ToString("C")</td>
                        <td>@(item.Department?.DepartmentName ?? "N/A")</td>
                        <td>
                            <a class="btn btn-sm btn-info" asp-controller="Course" asp-action="Edit" asp-route-id="@item.CourseId">Edit</a>
                            <a class="btn btn-sm btn-danger" asp-controller="Course" asp-action="Delete" asp-route-id="@item.CourseId" onclick="return confirm('Are you sure?')">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            No courses found. <a asp-controller="Course" asp-action="Create">Create a new course</a>
        </div>
    }
</div>