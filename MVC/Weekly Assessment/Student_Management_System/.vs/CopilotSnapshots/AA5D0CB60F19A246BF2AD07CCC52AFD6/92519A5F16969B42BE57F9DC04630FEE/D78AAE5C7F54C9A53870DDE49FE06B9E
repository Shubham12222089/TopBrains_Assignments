@model IEnumerable<Department>

@{
    ViewData["Title"] = "Departments";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-8">
            <h2>Departments</h2>
        </div>
        <div class="col-md-4 text-end">
            <a class="btn btn-primary" asp-controller="Department" asp-action="Create">Add New Department</a>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Department Name</th>
                    <th>Description</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.DepartmentName</td>
                        <td>@(string.IsNullOrEmpty(item.Description) ? "-" : item.Description)</td>
                        <td>
                            <a class="btn btn-sm btn-info" asp-controller="Department" asp-action="Edit" asp-route-id="@item.DepartmentId">Edit</a>
                            <a class="btn btn-sm btn-danger" asp-controller="Department" asp-action="Delete" asp-route-id="@item.DepartmentId" onclick="return confirm('Are you sure?')">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            No departments found. <a asp-controller="Department" asp-action="Create">Create a new department</a>
        </div>
    }
</div>