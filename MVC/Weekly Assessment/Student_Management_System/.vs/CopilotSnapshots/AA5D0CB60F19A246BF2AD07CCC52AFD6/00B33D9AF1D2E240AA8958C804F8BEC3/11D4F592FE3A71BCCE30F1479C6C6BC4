@{
    ViewData["Title"] = "Student Profile";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header bg-dark text-white">
                    <h2 class="mb-0">Student Profile</h2>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-12">
                            <h5>Profile Information</h5>
                            <hr />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label"><strong>Student ID:</strong></label>
                            <p class="text-muted">-</p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label"><strong>Full Name:</strong></label>
                            <p class="text-muted">-</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label"><strong>Email:</strong></label>
                            <p class="text-muted">-</p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label"><strong>Phone Number:</strong></label>
                            <p class="text-muted">-</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label"><strong>Department:</strong></label>
                            <p class="text-muted">-</p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label"><strong>Course:</strong></label>
                            <p class="text-muted">-</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-12">
                            <label class="form-label"><strong>Address:</strong></label>
                            <p class="text-muted">-</p>
                        </div>
                    </div>

                    <hr />

                    <div class="mb-3">
                        <a href="/StudentDashboard/Index" class="btn btn-secondary">Back to Dashboard</a>
                        <button class="btn btn-primary">Edit Profile</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
