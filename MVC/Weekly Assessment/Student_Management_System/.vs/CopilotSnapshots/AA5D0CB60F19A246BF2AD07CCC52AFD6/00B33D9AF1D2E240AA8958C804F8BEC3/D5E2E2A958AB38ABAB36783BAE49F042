@model IEnumerable<Student>

@{
    ViewData["Title"] = "Students";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-8">
            <h2>Students</h2>
        </div>
        <div class="col-md-4 text-end">
            <a class="btn btn-primary" asp-controller="Student" asp-action="Create">Add New Student</a>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Student Name</th>
                    <th>Email</th>
                    <th>Phone Number</th>
                    <th>Address</th>
                    <th>Department</th>
                    <th>Course</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.StudentName</td>
                        <td>@item.Email</td>
                        <td>@item.PhoneNumber</td>
                        <td>@item.Address</td>
                        <td>@(item.Department?.DepartmentName ?? "N/A")</td>
                        <td>@(item.Course?.CourseName ?? "N/A")</td>
                        <td>
                            <a class="btn btn-sm btn-info" asp-controller="Student" asp-action="Edit" asp-route-id="@item.StudentId">Edit</a>
                            <a class="btn btn-sm btn-danger" asp-controller="Student" asp-action="Delete" asp-route-id="@item.StudentId" onclick="return confirm('Are you sure?')">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            No students found. <a asp-controller="Student" asp-action="Create">Create a new student</a>
        </div>
    }
</div>
