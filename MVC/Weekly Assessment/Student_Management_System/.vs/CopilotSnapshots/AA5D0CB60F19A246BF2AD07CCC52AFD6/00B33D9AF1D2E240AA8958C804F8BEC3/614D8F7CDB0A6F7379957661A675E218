@model IEnumerable<Student>

@{
    ViewData["Title"] = "Students";
}

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-8">
            <h2>Students</h2>
        </div>
        <div class="col-md-4 text-end">
            <a class="btn btn-primary" asp-controller="Student" asp-action="Create">Add New Student</a>
        </div>
    </div>

    <!-- Search and Filter Section -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-light">
                    <h6 class="mb-0">Search & Filter</h6>
                </div>
                <div class="card-body">
                    <form method="get" asp-action="Index">
                        <div class="row">
                            <div class="col-md-4">
                                <label for="searchName" class="form-label">Search by Name</label>
                                <input type="text" id="searchName" name="searchName" class="form-control" placeholder="Enter student name" value="@ViewBag.SearchName" />
                            </div>
                            <div class="col-md-4">
                                <label for="departmentFilter" class="form-label">Filter by Department</label>
                                <select id="departmentFilter" name="departmentId" class="form-select">
                                    <option value="">-- All Departments --</option>
                                    @foreach (var dept in ViewBag.Departments ?? new List<Department>())
                                    {
                                        <option value="@dept.DepartmentId" selected="@(ViewBag.SelectedDepartmentId == dept.DepartmentId)">@dept.DepartmentName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label>&nbsp;</label>
                                <div class="d-grid">
                                    <button type="submit" class="btn btn-success">Search</button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row mb-3">
            <div class="col-md-12">
                <p class="text-muted">Total Students: <strong>@Model.Count()</strong></p>
            </div>
        </div>

        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Student Name</th>
                    <th>Email</th>
                    <th>Phone Number</th>
                    <th>Address</th>
                    <th>Department</th>
                    <th>Course</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.StudentName</td>
                        <td>@item.Email</td>
                        <td>@item.PhoneNumber</td>
                        <td>@item.Address</td>
                        <td>@(item.Department?.DepartmentName ?? "N/A")</td>
                        <td>@(item.Course?.CourseName ?? "N/A")</td>
                        <td>
                            <a class="btn btn-sm btn-info" asp-controller="Student" asp-action="Edit" asp-route-id="@item.StudentId">Edit</a>
                            <a class="btn btn-sm btn-danger" asp-controller="Student" asp-action="Delete" asp-route-id="@item.StudentId" onclick="return confirm('Are you sure?')">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            No students found. <a asp-controller="Student" asp-action="Create">Create a new student</a>
        </div>
    }
</div>

